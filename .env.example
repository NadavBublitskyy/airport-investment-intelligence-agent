# Copy this file to .env and fill in your own values.

# API key for OpenRouter (https://openrouter.ai/keys). Required to run the
# conversational agent, and as the last-resort data source when every live
# public API for a data point has failed (see src/data_sources/llm_fallback_client.py).
OPENROUTER_API_KEY=your_key_here

# Any model available on OpenRouter. Defaults to a free model so the app
# works without a paid plan. Swap for a stronger model if you have credits.
# Note: OpenRouter's free-tier roster changes over time - if this model stops
# working, check https://openrouter.ai/models?max_price=0 for a current
# free model that supports tool/function calling.
MODEL_NAME=openai/gpt-oss-20b:free

# Optional: attribution headers OpenRouter shows on its public leaderboards.
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_SITE_NAME=Airport Investment Intelligence Agent

# Optional: how many of the most recent user turns to keep in the conversation
# sent to the LLM before older turns are dropped entirely (context-window
# management - see src/agent/orchestrator.py::_compact_history).
MAX_HISTORY_TURNS=10

# Optional: timeout (seconds) for outbound calls to public data APIs.
DATA_SOURCE_TIMEOUT_SECONDS=8

# Required by the NWS weather API's usage policy: identify your app with a
# contact so NWS can reach you if something misbehaves.
NWS_USER_AGENT=airport-investment-intelligence-agent (contact: your_email@example.com)

# US Census Bureau API key (https://api.census.gov/data/key_signup.html - instant
# free signup). Used for real regional population growth in the New England
# expansion score. If unset, that one input falls back to an LLM estimate.
CENSUS_API_KEY=

# BEA (Bureau of Economic Analysis) API key (https://apps.bea.gov/api/signup/ -
# instant free signup). Used for real regional income growth in the New
# England expansion score. If unset, that one input falls back to an LLM estimate.
BEA_API_KEY=
